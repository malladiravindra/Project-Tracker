# Copy to frontend/.env.local (never commit .env.local).
#
# Origin of the Django backend, WITHOUT the /api prefix (added by lib/apiUrl.ts). It is inlined into the browser
# bundle at BUILD time, so it must be public information: never put secrets in NEXT_PUBLIC_* variables.
#   - development: optional; falls back to http://127.0.0.1:8000 when unset.
#   - production build (`next build`): REQUIRED. The build fails if it is missing, invalid, http:// or localhost.
# ONE origin only (no comma list, no trailing path). Use your real backend Vercel project's URL:
NEXT_PUBLIC_API_URL=https://project-tracker-beta-umber.vercel.app

# Local backend instead:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
