# Copy to backend/.env for LOCAL development. .env is git-ignored: never commit it, never put real secrets here.
# backend/.env is NOT deployed. On Vercel, set these variables in the dashboard (Project > Settings > Environment Variables).
#
# `python manage.py ...` defaults to DEVELOPMENT. Anything else that imports the settings (gunicorn, wsgi/asgi,
# Vercel) defaults to PRODUCTION and REFUSES TO START unless the production values below are set.

# ======================= LOCAL DEVELOPMENT (.env) =======================
DJANGO_ENV=development
# DJANGO_DEBUG=true               # LOCAL ONLY. Never set this on Vercel (production ignores it anyway).
DJANGO_SECRET_KEY=generate-with-python-c-import-secrets-print-secrets.token_urlsafe-64
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DATABASE_URL left empty => SQLite (backend/db.sqlite3). SQLite is for local development only.
DJANGO_TIME_ZONE=Asia/Kolkata     # authoritative zone for "today" (overdue / due today / key dates)


# Initial administrator for `python manage.py ensure_admin` (local setup only; not read by the running app).
# Leave unset to be prompted for the password instead. Choose your own values; never commit real ones.
# INITIAL_ADMIN_USERNAME=<admin-username>
# INITIAL_ADMIN_PASSWORD=<strong-password>
